<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BoldMigrate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <!-- Security overrides for transitive dependencies pulled by BoldReports / EF Sqlite -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="SharpCompress" Version="0.50.12" />
    <PackageReference Include="Snappier" Version="1.3.3" />
    <!-- Bold Reports viewer/designer server side, used by Step 4 to preview and edit staged reports locally.
         SQL Server support is built in; the data extensions let the designer query every other provider
         Bold Reports supports. Keep the version in step with the CDN scripts in wwwroot/index.html. -->
    <PackageReference Include="BoldReports.AspNet.Core" Version="15.1.17" />
    <PackageReference Include="BoldReports.Net.Core" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.AWSSecretsManager" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.Csv" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.ElasticSearch" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.Excel" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.GoogleBigQuery" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.MongoDB" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.MySQL" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.Oracle" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.PostgreSQL" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.Snowflake" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.SSAS" Version="15.1.17" />
    <PackageReference Include="BoldReports.Data.WebData" Version="15.1.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoldMigrate.Core\BoldMigrate.Core.csproj" />
    <ProjectReference Include="..\BoldMigrate.Infrastructure\BoldMigrate.Infrastructure.csproj" />
    <ProjectReference Include="..\BoldMigrate.Engine\BoldMigrate.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\..\data\compatibility-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>data\compatibility-rules.json</Link>
    </None>
  </ItemGroup>

</Project>
