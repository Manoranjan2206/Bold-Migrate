<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BoldMigrate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoldMigrate.Core\BoldMigrate.Core.csproj" />
    <ProjectReference Include="..\BoldMigrate.Infrastructure\BoldMigrate.Infrastructure.csproj" />
    <ProjectReference Include="..\BoldMigrate.Engine\BoldMigrate.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\..\data\compatibility-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>data\compatibility-rules.json</Link>
    </None>
  </ItemGroup>

</Project>
